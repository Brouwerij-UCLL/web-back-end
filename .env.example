PORT=3000

# Bestand waarin de SQLite-database bewaard wordt.
DATABASE_FILE=./data/app.db

# De back-end start zelf een MQTT-broker op MQTT_PORT; ketel en kast verbinden daarmee.
# Zet MQTT_BROKER=off en MQTT_URL op een externe broker om die te gebruiken (bv. mqtt://broker.emqx.io:1883).
MQTT_PORT=1883
# Login voor de broker; leeg = iedereen in het netwerk mag verbinden.
MQTT_USERNAME=
MQTT_PASSWORD=

# Front-ends die de API vanuit een andere origin mogen aanspreken (CORS), kommagescheiden.
# De eigen origin van de back-end (bv. Swagger UI op /api/docs) is altijd toegelaten.
# Zet hier op Vercel ook de origin van de gedeployde front-end bij.
CORS_ORIGINS=http://localhost:4200,http://localhost,https://localhost
